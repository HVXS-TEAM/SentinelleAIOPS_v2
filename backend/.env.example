# Sentinelle AIOps — configuration locale
# Copiez ce fichier en `backend/.env` (en version .exe : `.env` à côté de l'exécutable).
# Toutes les lignes sont facultatives : sans elles, les secrets sont générés au premier
# démarrage et conservés dans `.sentinelle_secrets.json` (ignoré par git).
# NE COMMITEZ JAMAIS le vrai fichier `.env`.

# Clé de signature des jetons JWT (>= 32 caractères).
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

# Clé Fernet (chiffrement des secrets stockés : SSH, SNMP, notifications).
# Si vous la changez, les secrets déjà chiffrés avec l'ancienne clé deviennent illisibles.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# Base de données (SQLite par défaut, PostgreSQL possible)
# DATABASE_URL=sqlite:///C:/chemin/vers/sentinelle.db

# Origines autorisées par CORS (format JSON). Inutile en production : le front est servi par FastAPI.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Auto-inscription publique (comptes créés = Visiteur). Fermée par défaut ; true pour l'ouvrir.
# ALLOW_SELF_REGISTRATION=false

# Création de compte depuis la machine qui héberge Sentinelle : le profil (Administrateur, Technicien,
# Visiteur) est choisi par la personne qui dispose de l'application. false = administrateur connecté requis.
# LOCAL_ACCOUNT_CREATION=true

# Mot de passe oublié par e-mail (facultatif). Sans SMTP_HOST et SMTP_FROM : code à usage unique généré par l'administrateur.
# SMTP_HOST=smtp.exemple.fr
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=sentinelle@exemple.fr
# SMTP_STARTTLS=true
# PUBLIC_URL=http://127.0.0.1:8000
# RESET_TOKEN_MINUTES=30

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR ou CRITICAL (fichier : logs/sentinelle.log)
# LOG_LEVEL=INFO

# Clés d'hôte SSH : false = confiance au premier contact puis épinglage ; true = refuse tout hôte non enregistré
# SSH_STRICT_HOST_KEYS=false

# Remarque : OLLAMA_URL (défaut http://localhost:11434), OLLAMA_MODEL (défaut llama3) et
# SENTINELLE_DATA_DIR (dossier unique des données : base, sauvegardes, secrets, notifications ;
# par défaut la racine du dépôt, ou le dossier de l'exécutable) se définissent comme variables
# d'environnement système, pas dans ce fichier.

